      "isDeleted": false,
      "boundElements": [],
      "updated": 1791919962988,
      "created": 1791919756776,
      "link": null,
      "locked": false,
      "text": "for brand in brands:\n\nfor iter in MAX_ITER:\n\nrun_llm(,.,...)\n\n# llm will spit out customers \n\n# --> information coefficient, lets say llm spits out mike as a potential\n# compare mike's ic with paul's ic ... if the ic crosses a threshold, add mike to the\nlist\n\n# choice of MAX_ITER depends ... open Q",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "for brand in brands:\n\nfor iter in MAX_ITER:\n\nrun_llm(,.,...)\n\n# llm will spit out customers \n\n# --> information coefficient, lets say llm spits out mike as a potential\n# compare mike's ic with paul's ic ... if the ic crosses a threshold, add mike to the list\n\n# choice of MAX_ITER depends ... open Q",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
